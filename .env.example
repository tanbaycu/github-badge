# ==============================================================
# GITTROPHY - CONFIGURATION ENVIRONMENT
# ==============================================================

# Target GitHub Personal Access Token (Classic PAT with 'repo', 'write:discussion' scopes)
# Tạo tại: https://github.com/settings/tokens (chọn repo, write:discussion, workflow)
GITHUB_TOKEN=your_github_token_here

# (Khuyên dùng cho Galaxy Brain Vàng): Helper GitHub Token (Clone account hoặc bạn bè)
# Cần thiết để tạo câu hỏi và chấp nhận câu trả lời hợp lệ cho Galaxy Brain (vì GitHub cấm tự chấp nhận bản thân)
HELPER_GITHUB_TOKEN=your_helper_token_here

# Tên Repository dùng để farm thành tựu (Sẽ tự động tạo public repo nếu chưa có)
TARGET_REPO=github-trophy-vault

# Hạn ngạch mục tiêu (Quotas)
# Pull Shark: Bronze=2, Silver=16, Gold=128
SHARK_QUOTA=128

# Galaxy Brain: Bronze=2, Silver=8, Gold=16 hoặc 32
GALAXY_QUOTA=32

# Pair Extraordinaire mục tiêu PR co-authored
PAIR_QUOTA=16

# Thời gian trễ (ms) giữa các request để bypass GitHub Secondary Rate Limit & Anti-Abuse
REQUEST_DELAY_MS=2000

# Port cho Web GUI Dashboard
PORT=3456
